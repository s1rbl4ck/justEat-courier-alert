# Example environment variables for just-eat-vehicle-checker
# Copy this file to .env and fill values when running locally

# URL to monitor (must include ?city=slug)
TARGET_URL=https://www.justeat.it/en/courier/form?city=padua

# Comma-separated list of target vehicle labels to alert on (substring match)
TARGET_VEHICLES=Driver Bike,Company Bike,Driver E-Bike,Company E-Bike,Driver Scooter,Company Scooter,Driver E-Roller,Driver Car / Kombi,Company Car / Kombi,Driver Buffer Vehicle

# Telegram bot credentials (required for alerts)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=987654321

# Interval between checks in milliseconds (default 300000 = 5 minutes)
CHECK_INTERVAL_MS=300000

# Server port
PORT=8080